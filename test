<!DOCTYPE html>
<html lang="en-CA">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="Five full-length practice tests for the Ontario Grade 3 EQAO Assessment of Reading, Writing and Mathematics.">
<title>Grade 3 EQAO Practice Tests</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,600;12..96,700;12..96,800&family=Literata:ital,opsz,wght@0,7..72,400;0,7..72,500;0,7..72,600;1,7..72,400&family=Public+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap">
<style>
  html{color-scheme:light dark}
  body{margin:0;font:14px/1.5 system-ui,sans-serif}
  img{max-width:100%}
  [hidden]{display:none!important}
</style>
<style>
/* ------------------------------------------------------------------ tokens */
:root{
  --paper:#F7F6F1; --surface:#FFFFFF; --surface-2:#F1EFE8; --surface-3:#E9E6DC;
  --ink:#16202C; --ink-soft:#4C5A69; --ink-faint:#84919F;
  --rule:#DEDBD1; --rule-strong:#C4C0B3;
  --accent:#1B6B7F; --accent-ink:#0F4E5E; --accent-wash:#E2EDEF;
  --spark:#C25A1B; --spark-wash:#FAEDE2;
  --good:#2C7A44; --good-wash:#E3F0E6;
  --bad:#AE3D2B; --bad-wash:#F8E7E3;
  --lv1:#AE3D2B; --lv2:#C08019; --lv3:#2C7A44; --lv4:#1B6B7F;
  --focus:#1B6B7F;
  --shadow-s:0 1px 2px rgba(20,28,38,.05);
  --shadow-m:0 2px 4px rgba(20,28,38,.05),0 8px 20px rgba(20,28,38,.05);
  --r-s:6px; --r-m:10px; --r-l:16px;
  --sans:"Public Sans",-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
  --disp:"Bricolage Grotesque","Public Sans",-apple-system,sans-serif;
  --read:"Literata",Georgia,"Times New Roman",serif;
  --mono:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    --paper:#12171E; --surface:#1A2029; --surface-2:#212933; --surface-3:#2A333F;
    --ink:#E9EDF1; --ink-soft:#A3B0BD; --ink-faint:#78ured;
    --ink-faint:#788694;
    --rule:#2C3641; --rule-strong:#41505F;
    --accent:#63BDD0; --accent-ink:#8FD6E5; --accent-wash:#15303A;
    --spark:#E4914F; --spark-wash:#32241A;
    --good:#66BE83; --good-wash:#162E1E; --bad:#DC8875; --bad-wash:#311C17;
    --lv1:#DC8875; --lv2:#DBA843; --lv3:#66BE83; --lv4:#63BDD0;
    --focus:#8FD6E5;
    --shadow-s:0 1px 2px rgba(0,0,0,.3);
    --shadow-m:0 2px 4px rgba(0,0,0,.3),0 8px 20px rgba(0,0,0,.25);
  }
}
:root[data-theme="dark"]{
  --paper:#12171E; --surface:#1A2029; --surface-2:#212933; --surface-3:#2A333F;
  --ink:#E9EDF1; --ink-soft:#A3B0BD; --ink-faint:#788694;
  --rule:#2C3641; --rule-strong:#41505F;
  --accent:#63BDD0; --accent-ink:#8FD6E5; --accent-wash:#15303A;
  --spark:#E4914F; --spark-wash:#32241A;
  --good:#66BE83; --good-wash:#162E1E; --bad:#DC8875; --bad-wash:#311C17;
  --lv1:#DC8875; --lv2:#DBA843; --lv3:#66BE83; --lv4:#63BDD0;
  --focus:#8FD6E5;
  --shadow-s:0 1px 2px rgba(0,0,0,.3);
  --shadow-m:0 2px 4px rgba(0,0,0,.3),0 8px 20px rgba(0,0,0,.25);
}

/* -------------------------------------------------------------------- base */
*{box-sizing:border-box}
body{
  margin:0;background:var(--paper);color:var(--ink);
  font-family:var(--sans);font-size:16px;line-height:1.6;
  -webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;
}
h1,h2,h3{font-family:var(--disp);margin:0;text-wrap:balance;letter-spacing:-.015em;line-height:1.15}
p{margin:0}
button{font:inherit;color:inherit}
:focus-visible{outline:2.5px solid var(--focus);outline-offset:2px;border-radius:3px}
.skip{position:absolute;left:-9999px;top:0;background:var(--accent);color:#fff;padding:10px 16px;z-index:60;border-radius:0 0 var(--r-s) 0}
.skip:focus{left:0}
.eyebrow{font-size:11.5px;font-weight:700;letter-spacing:.13em;text-transform:uppercase;color:var(--accent);margin:0}
.sec-title{font-size:clamp(21px,3vw,26px);font-weight:700;color:var(--ink)}
.sec-lede{color:var(--ink-soft);font-size:14.5px;margin-top:6px;max-width:60ch}
.panel-label{font-size:11px;font-weight:700;letter-spacing:.11em;text-transform:uppercase;color:var(--ink-faint)}

/* ------------------------------------------------------------------ chrome */
.topbar{
  display:flex;align-items:center;justify-content:space-between;gap:16px;
  padding:14px 20px;border-bottom:1px solid var(--rule);background:var(--surface);
}
.brand{display:flex;align-items:center;gap:10px;min-width:0}
.brand-mark{
  width:30px;height:30px;flex:0 0 30px;border-radius:7px;background:var(--accent);
  color:#fff;font-family:var(--disp);font-weight:800;font-size:14px;
  display:grid;place-items:center;letter-spacing:-.02em;
}
:root[data-theme="dark"] .brand-mark{color:#0F1A20}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]) .brand-mark{color:#0F1A20}}
.brand-name{font-family:var(--disp);font-weight:700;font-size:15px;letter-spacing:-.01em}
.brand-sub{font-size:12px;color:var(--ink-faint);display:block;font-family:var(--sans);font-weight:400;letter-spacing:0}
.icon-toggle{
  border:1px solid var(--rule-strong);background:var(--surface);border-radius:999px;
  width:36px;height:36px;display:grid;place-items:center;cursor:pointer;flex:0 0 36px;
}
.icon-toggle:hover{border-color:var(--accent);color:var(--accent)}
.icon-toggle svg{width:17px;height:17px;fill:none;stroke:currentColor;stroke-width:1.7}

/* --------------------------------------------------------------- scorebar */
#scorebar{
  position:sticky;top:0;z-index:20;background:var(--surface);
  border-bottom:1px solid var(--rule);box-shadow:var(--shadow-s);
}
.scorebar-inner{
  max-width:920px;margin:0 auto;padding:10px 20px 8px;
  display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;
}
.sb-left{display:flex;align-items:center;gap:12px;min-width:0}
.sb-test{font-family:var(--disp);font-weight:700;font-size:15px}
.sb-marks{display:flex;gap:6px;flex-wrap:wrap}
.sb-chip{
  border:1px solid var(--rule);border-radius:var(--r-s);padding:4px 9px;background:var(--surface-2);
  display:flex;flex-direction:column;line-height:1.25;min-width:64px;
}
.sb-chip-label{font-size:9.5px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-faint)}
.sb-chip-val{font-size:14px;font-weight:700;font-variant-numeric:tabular-nums}
.sb-total{background:var(--accent-wash);border-color:var(--accent)}
.sb-total .sb-chip-val{color:var(--accent-ink);font-size:15.5px}
.progress{height:5px;background:var(--surface-3);overflow:hidden}
.progress-fill{height:100%;background:var(--accent);transition:width .3s ease}
.progress-label{
  max-width:920px;margin:0 auto;padding:4px 20px 7px;
  font-size:11.5px;color:var(--ink-faint);font-variant-numeric:tabular-nums;
}

/* ----------------------------------------------------------------- layout */
#app{max-width:920px;margin:0 auto;padding-block:28px 64px;padding-left:20px;padding-right:20px}

/* ------------------------------------------------------------------- home */
.home-head{max-width:62ch;margin-bottom:34px}
.home-title{font-size:clamp(30px,6vw,50px);font-weight:800;letter-spacing:-.03em;margin:10px 0 14px;display:block}
.home-title span{display:block}
.home-title-sub{font-size:clamp(15px,2.4vw,20px);font-weight:500;color:var(--ink-soft);letter-spacing:-.01em;margin-top:6px;line-height:1.3}
.home-lede{color:var(--ink-soft);font-size:15.5px;max-width:62ch}
.test-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:12px;margin-bottom:46px}
.test-card{
  text-align:left;background:var(--surface);border:1px solid var(--rule);border-radius:var(--r-m);
  padding:16px 16px 13px;cursor:pointer;display:flex;flex-direction:column;gap:12px;
  transition:border-color .18s ease,box-shadow .18s ease,transform .18s ease;
}
.test-card:hover{border-color:var(--accent);box-shadow:var(--shadow-m);transform:translateY(-2px)}
.test-card-top{display:flex;gap:12px;align-items:flex-start}
.test-no{
  font-family:var(--disp);font-weight:800;font-size:20px;width:38px;height:38px;flex:0 0 38px;
  display:grid;place-items:center;border-radius:9px;background:var(--accent-wash);color:var(--accent-ink);
}
.test-card-title{font-size:17px;font-weight:700}
.test-card-sub{font-size:12.5px;color:var(--ink-faint);margin-top:2px;font-variant-numeric:tabular-nums}
.mini-bar{height:4px;background:var(--surface-3);border-radius:999px;overflow:hidden}
.mini-bar-fill{height:100%;background:var(--accent);border-radius:999px}
.test-card-foot{display:flex;justify-content:space-between;align-items:baseline;gap:8px;font-size:12.5px;color:var(--ink-soft);font-variant-numeric:tabular-nums}
.test-card-mark{font-weight:700;color:var(--ink);font-size:14px}
.how{margin-bottom:34px}
.how-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:1px;background:var(--rule);border:1px solid var(--rule);border-radius:var(--r-m);overflow:hidden;margin-top:18px}
.how-card{background:var(--surface);padding:18px 17px}
.how-card h3{font-size:14.5px;font-weight:700;margin-bottom:7px}
.how-card p{font-size:13.5px;color:var(--ink-soft);line-height:1.62}
.how-note{margin-top:9px !important;font-size:12.5px !important;color:var(--accent-ink) !important;font-weight:600}
.honest{border-left:3px solid var(--spark);background:var(--spark-wash);padding:16px 18px;border-radius:0 var(--r-m) var(--r-m) 0;display:flex;flex-direction:column;gap:9px;margin-bottom:30px}
.honest p{font-size:13.5px;color:var(--ink-soft);line-height:1.65;max-width:72ch}
.site-foot{border-top:1px solid var(--rule);padding-top:18px}
.site-foot p{font-size:12px;color:var(--ink-faint);line-height:1.6;max-width:80ch}

/* ------------------------------------------------------------------- rail */
.rail{display:flex;flex-wrap:wrap;gap:16px;align-items:flex-end;margin-bottom:26px;padding-bottom:18px;border-bottom:1px solid var(--rule)}
.rail-group{display:flex;flex-direction:column;gap:6px}
.rail-group-name{font-size:10.5px;font-weight:700;letter-spacing:.11em;text-transform:uppercase;color:var(--ink-faint)}
.rail-row{display:flex;gap:5px;flex-wrap:wrap}
.chip{
  border:1px solid var(--rule-strong);background:var(--surface);border-radius:var(--r-s);
  padding:5px 9px;cursor:pointer;display:flex;flex-direction:column;line-height:1.25;min-width:60px;
  transition:border-color .15s,background .15s;
}
.chip:hover{border-color:var(--accent)}
.chip-name{font-size:12px;font-weight:600;white-space:nowrap}
.chip-count{font-size:10px;color:var(--ink-faint);font-variant-numeric:tabular-nums}
.chip.active{background:var(--accent);border-color:var(--accent);color:#fff}
.chip.active .chip-count{color:rgba(255,255,255,.8)}
:root[data-theme="dark"] .chip.active,
:root[data-theme="dark"] .chip.active .chip-count{color:#0F1A20}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]) .chip.active,
  :root:not([data-theme="light"]) .chip.active .chip-count{color:#0F1A20}
}
.chip.done:not(.active){border-color:var(--good);background:var(--good-wash)}
.rail-results{margin-left:auto}

/* --------------------------------------------------------- section header */
.section-head{margin-bottom:22px}
.section-title{font-size:clamp(23px,4vw,33px);font-weight:800;letter-spacing:-.025em;margin:6px 0 6px}
.section-facts{font-size:13px;color:var(--ink-faint);font-variant-numeric:tabular-nums}

/* ---------------------------------------------------------------- passage */
.passage{
  background:var(--surface);border:1px solid var(--rule);border-radius:var(--r-m);
  padding:24px 24px 22px;margin-bottom:26px;box-shadow:var(--shadow-s);
}
.passage-head{display:flex;gap:10px;align-items:center;margin-bottom:10px;flex-wrap:wrap}
.passage-kind{font-size:10.5px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#fff;background:var(--accent);padding:3px 8px;border-radius:999px}
:root[data-theme="dark"] .passage-kind{color:#0F1A20}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]) .passage-kind{color:#0F1A20}}
.passage-words{font-size:11.5px;color:var(--ink-faint);font-variant-numeric:tabular-nums}
.passage-title{font-family:var(--read);font-size:clamp(20px,3.4vw,27px);font-weight:600;letter-spacing:-.01em;margin-bottom:14px}
.passage-intro{font-size:13.5px;color:var(--ink-soft);font-style:italic;margin-bottom:12px}
.passage-body{display:flex;flex-direction:column;gap:13px}
.para{display:flex;gap:13px;align-items:flex-start}
.para-no{
  flex:0 0 20px;font-size:11px;font-weight:700;color:var(--ink-faint);
  font-variant-numeric:tabular-nums;padding-top:5px;text-align:right;
  border-right:1px solid var(--rule);padding-right:7px;align-self:stretch;
}
.para p{font-family:var(--read);font-size:16.5px;line-height:1.72;max-width:66ch}
.passage-feature{margin-top:18px}

/* ------------------------------------------------------------ writing task */
.prompt-card{
  background:var(--accent-wash);border:1px solid var(--accent);border-radius:var(--r-m);
  padding:20px 22px;margin-bottom:26px;display:flex;flex-direction:column;gap:8px;
}
.prompt-title{font-size:20px;font-weight:700;letter-spacing:-.015em}
.prompt-instruction{font-size:15.5px;color:var(--ink);line-height:1.65;max-width:64ch}
.prompt-list{margin:2px 0 0;padding-left:20px;display:flex;flex-direction:column;gap:4px}
.prompt-list li{font-size:13.5px;color:var(--ink-soft)}

/* ----------------------------------------------------------------- qcards */
.qlist{display:flex;flex-direction:column;gap:14px}
.qcard{
  background:var(--surface);border:1px solid var(--rule);border-left:3px solid var(--rule-strong);
  border-radius:0 var(--r-m) var(--r-m) 0;padding:18px 20px 16px;
  display:flex;flex-direction:column;gap:13px;
}
.qcard.is-right{border-left-color:var(--good)}
.qcard.is-wrong{border-left-color:var(--bad)}
.qhead{display:flex;gap:12px;align-items:flex-start}
.qnum{
  flex:0 0 27px;height:27px;border-radius:7px;background:var(--surface-3);color:var(--ink-soft);
  font-family:var(--disp);font-weight:700;font-size:13px;display:grid;place-items:center;
}
.qmeta{min-width:0;flex:1}
.qtags{display:flex;gap:5px;flex-wrap:wrap}
.tag{
  font-size:10px;font-weight:600;letter-spacing:.04em;padding:2px 7px;border-radius:999px;
  background:var(--surface-2);color:var(--ink-faint);border:1px solid var(--rule);white-space:nowrap;
}
.tag-strand{background:var(--accent-wash);color:var(--accent-ink);border-color:transparent;font-weight:700}
.tag-field{background:var(--spark-wash);color:var(--spark);border-color:transparent}
.tag-pts{font-variant-numeric:tabular-nums}
.qstem{font-size:16.5px;line-height:1.6;max-width:64ch}
.qstem b{font-weight:700}
.qbody{display:flex;flex-direction:column;gap:10px}
.qnote{font-size:12.5px;color:var(--ink-faint)}

/* --------------------------------------------------------------- choices */
.choices{display:flex;flex-direction:column;gap:7px}
.choice{
  display:flex;align-items:flex-start;gap:11px;padding:11px 13px;cursor:pointer;
  border:1px solid var(--rule);border-radius:var(--r-m);background:var(--surface-2);
  transition:border-color .14s,background .14s;
}
.choice:hover{border-color:var(--accent)}
.choice input{margin:2px 0 0;accent-color:var(--accent);width:18px;height:18px;flex:0 0 18px}
.choice input:disabled{cursor:default}
.choice-key{font-family:var(--disp);font-weight:700;font-size:13px;color:var(--ink-faint);flex:0 0 14px}
.choice-text{font-size:15.5px;line-height:1.5;min-width:0}
.choice.key{border-color:var(--good);background:var(--good-wash)}
.choice.key .choice-key{color:var(--good)}
.choice.miss{border-color:var(--bad);background:var(--bad-wash)}
.choice.miss .choice-key{color:var(--bad)}

/* ------------------------------------------------------------ slots/drag */
.slot-select{
  font-family:var(--sans);font-size:15px;padding:6px 9px;border-radius:var(--r-s);
  border:1.5px solid var(--accent);background:var(--surface);color:var(--ink);
  margin:0 3px;max-width:100%;
}
.slot-select.ok{border-color:var(--good);background:var(--good-wash)}
.slot-select.no{border-color:var(--bad);background:var(--bad-wash)}
.slot-row{display:flex;gap:8px;flex-wrap:wrap}
.token-tray{background:var(--surface-2);border:1px dashed var(--rule-strong);border-radius:var(--r-m);padding:11px 13px;display:flex;flex-direction:column;gap:8px}
.token-row{display:flex;gap:7px;flex-wrap:wrap}
.token{
  border:1.5px dashed var(--rule-strong);background:var(--surface);border-radius:var(--r-m);
  padding:7px 13px;font-size:15px;font-weight:600;cursor:grab;font-variant-numeric:tabular-nums;
}
.token:hover{border-color:var(--accent)}
.token.picked{border-style:solid;border-color:var(--accent);background:var(--accent-wash);color:var(--accent-ink)}
.token.used{opacity:.32;cursor:default;text-decoration:line-through}
.drop-zone{display:flex;gap:9px;flex-wrap:wrap;align-items:flex-start}
.drop-target{
  min-width:78px;min-height:46px;border:2px dashed var(--rule-strong);border-radius:var(--r-m);
  background:var(--surface-2);display:flex;flex-direction:column;align-items:center;justify-content:center;
  padding:6px 10px;cursor:pointer;gap:1px;
}
.drop-target.over{border-color:var(--accent);background:var(--accent-wash)}
.drop-target.filled{border-style:solid;border-color:var(--accent);background:var(--accent-wash)}
.drop-target.fixed{border-style:solid;border-color:var(--rule-strong);background:var(--surface-3);cursor:default}
.drop-target.ok{border-color:var(--good);background:var(--good-wash)}
.drop-target.no{border-color:var(--bad);background:var(--bad-wash)}
.tok-text{font-size:15px;font-weight:600;font-variant-numeric:tabular-nums}
.tok-text.placeholder{min-height:20px;min-width:26px}
.drop-label{font-size:10px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--ink-faint)}
.eqlines{display:flex;flex-direction:column;gap:9px;font-size:16.5px;font-variant-numeric:tabular-nums}
.eqline{display:flex;align-items:center;gap:5px;flex-wrap:wrap}
.eqline .drop-target{min-width:52px;min-height:36px;padding:3px 7px}

/* ------------------------------------------------------------------ order */
.order-list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:6px;counter-reset:none}
.order-item{
  display:flex;align-items:center;gap:11px;padding:9px 12px;
  border:1px solid var(--rule);border-radius:var(--r-m);background:var(--surface-2);
}
.order-item.ok{border-color:var(--good);background:var(--good-wash)}
.order-item.no{border-color:var(--bad);background:var(--bad-wash)}
.order-pos{font-family:var(--disp);font-weight:700;font-size:13px;color:var(--ink-faint);flex:0 0 16px}
.order-text{flex:1;font-size:15px;min-width:0}
.order-ctrls{display:flex;gap:4px;flex:0 0 auto}
.iconbtn{
  width:31px;height:31px;border:1px solid var(--rule-strong);background:var(--surface);
  border-radius:var(--r-s);cursor:pointer;font-size:14px;line-height:1;display:grid;place-items:center;
}
.iconbtn:hover:not(:disabled){border-color:var(--accent);color:var(--accent)}
.iconbtn:disabled{opacity:.3;cursor:default}

/* -------------------------------------------------------------- open resp */
.answer-box{
  width:100%;font-family:var(--read);font-size:16px;line-height:1.6;padding:13px 14px;
  border:1.5px solid var(--rule-strong);border-radius:var(--r-m);background:var(--surface-2);
  color:var(--ink);resize:vertical;
}
.answer-box:focus{border-color:var(--accent);background:var(--surface)}
.selfmark{display:flex;flex-direction:column;gap:11px;padding-top:4px}
.rubric{border:1px solid var(--rule);border-radius:var(--r-m);padding:11px 13px 12px;margin:0;background:var(--surface-2)}
.rubric legend{font-size:12px;font-weight:700;color:var(--ink-soft);padding:0 6px}
.rubric-row{display:flex;align-items:flex-start;gap:9px;padding:5px 0;cursor:pointer}
.rubric-row input{margin:3px 0 0;accent-color:var(--accent);width:16px;height:16px;flex:0 0 16px}
.rubric-code{
  font-family:var(--disp);font-weight:700;font-size:12px;flex:0 0 20px;text-align:center;
  background:var(--surface-3);border-radius:4px;color:var(--ink-soft);line-height:1.7;
}
.rubric-text{font-size:13.5px;line-height:1.5;color:var(--ink-soft)}

/* ------------------------------------------------------------------ tools */
.qtools{display:flex;gap:7px;flex-wrap:wrap;padding-top:2px}
.btn{
  border:1px solid var(--rule-strong);background:var(--surface);border-radius:var(--r-s);
  padding:7px 13px;font-size:13.5px;font-weight:600;cursor:pointer;
  transition:border-color .14s,background .14s,color .14s;
}
.btn:hover:not(:disabled){border-color:var(--accent);color:var(--accent)}
.btn:disabled{opacity:.42;cursor:default}
.btn-hint{border-color:var(--spark);color:var(--spark)}
.btn-hint:hover:not(:disabled){background:var(--spark-wash);color:var(--spark);border-color:var(--spark)}
.btn-check{border-color:var(--accent);color:var(--accent)}
.btn-check:hover:not(:disabled){background:var(--accent-wash)}
.btn-primary{background:var(--accent);border-color:var(--accent);color:#fff}
.btn-primary:hover{background:var(--accent-ink);border-color:var(--accent-ink);color:#fff}
:root[data-theme="dark"] .btn-primary{color:#0F1A20}
:root[data-theme="dark"] .btn-primary:hover{color:#0F1A20}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]) .btn-primary,
  :root:not([data-theme="light"]) .btn-primary:hover{color:#0F1A20}
}
.btn-ghost{background:transparent;border-color:var(--rule-strong)}
.btn-danger{border-color:var(--bad);color:var(--bad)}
.btn-danger:hover{background:var(--bad-wash);color:var(--bad);border-color:var(--bad)}
.btn-back{padding:5px 10px;font-size:12.5px}

/* ----------------------------------------------------------------- panels */
.panel{border-radius:var(--r-m);padding:13px 15px;display:flex;flex-direction:column;gap:6px}
.panel p{font-size:14px;line-height:1.62;color:var(--ink-soft);max-width:64ch}
.panel-hint{background:var(--spark-wash);border-left:3px solid var(--spark);border-radius:0 var(--r-m) var(--r-m) 0}
.panel-answer{border:1px solid var(--rule)}
.panel-answer.good{background:var(--good-wash);border-color:var(--good)}
.panel-answer.bad{background:var(--bad-wash);border-color:var(--bad)}
.answer-head{display:flex;justify-content:space-between;align-items:baseline;gap:10px}
.verdict{font-family:var(--disp);font-weight:700;font-size:16px}
.panel-answer.good .verdict{color:var(--good)}
.panel-answer.bad .verdict{color:var(--bad)}
.verdict-pts{font-size:12.5px;font-weight:600;color:var(--ink-faint);font-variant-numeric:tabular-nums}
.answer-key{font-weight:600;color:var(--ink) !important;font-size:15px !important}
.sample{font-family:var(--read);font-size:15.5px !important;color:var(--ink) !important;line-height:1.7 !important}

/* ---------------------------------------------------------------- figures */
.fig-wrap{display:flex;flex-direction:column;gap:8px;align-items:flex-start;margin:2px 0}
.fig{color:var(--ink);display:block;height:auto}
.fig-scroll{max-width:100%;overflow-x:auto;padding-bottom:3px}
.fig-title{font-size:13.5px;font-weight:700;color:var(--ink)}
.fig-cap{font-size:12px;color:var(--ink-faint)}
.unitcap{display:flex;align-items:center;gap:5px}
.unitcap .fig{width:16px;flex:0 0 16px}
.fig-row{display:flex;gap:18px;flex-wrap:wrap;align-items:flex-end}
.fig-item{display:flex;flex-direction:column;align-items:center;gap:5px}
.fig-sublabel{font-size:12.5px;font-weight:600;color:var(--ink-soft);text-align:center}
.pattern-row{flex-wrap:nowrap;align-items:flex-end;gap:14px}
.term-no{font-size:11.5px;font-weight:700;border:1px solid var(--rule-strong);border-radius:4px;padding:0 7px;color:var(--ink-soft)}
.seq-row{gap:6px;flex-wrap:nowrap}
.seq-item{flex:0 0 auto}
.fig-axis{stroke:currentColor;stroke-width:1.4;fill:none}
.fig-grid{stroke:var(--rule);stroke-width:1;fill:none}
.fig-cell{stroke:var(--rule-strong);stroke-width:1}
.fig-tick{font-family:var(--sans);font-size:11px;fill:var(--ink-soft)}
.fig-mark{font-family:var(--disp);font-size:13px;font-weight:700;fill:var(--ink)}
.fig-axlabel{font-family:var(--sans);font-size:11px;font-weight:600;fill:var(--ink-soft)}
.fig-sectorlabel{font-family:var(--sans);font-size:11.5px;font-weight:700;fill:#fff}
.fig-sectorlabel-dark{font-family:var(--sans);font-size:12px;font-weight:700;fill:var(--ink)}
.money-val{font-family:var(--disp);font-size:17px;font-weight:800;fill:#1A2531}
.money-word{font-family:var(--sans);font-size:7px;fill:#1A2531;opacity:.7}
.coin-val{font-family:var(--disp);font-size:12px;font-weight:800;fill:#1A2531}
.picto-row{display:flex;gap:3px;align-items:center;flex-wrap:wrap;min-height:22px}
.picto-sym{color:var(--accent);flex:0 0 20px}
.picto-key{display:flex;align-items:center;gap:5px;font-size:12.5px;color:var(--ink-soft)}
.codeblock{
  font-family:var(--mono);font-size:14px;line-height:1.65;background:var(--surface-2);
  border:1px solid var(--rule);border-radius:var(--r-m);padding:12px 15px;margin:0;
  overflow-x:auto;max-width:100%;color:var(--ink);
}
.codeblock.vertical{font-size:17px;letter-spacing:.08em;line-height:1.5}
.framed-text{border:1px solid var(--rule-strong);border-radius:var(--r-m);padding:12px 15px;background:var(--surface-2);font-size:15px}

/* ----------------------------------------------------------------- tables */
.tbl-scroll{max-width:100%;overflow-x:auto}
.q-table{border-collapse:collapse;font-size:14.5px;background:var(--surface)}
.q-table th,.q-table td{border:1px solid var(--rule-strong);padding:7px 12px;text-align:left}
.q-table th{background:var(--surface-2);font-weight:700;font-size:13.5px}
.q-table td{font-variant-numeric:tabular-nums}
.q-table.calendar th,.q-table.calendar td{text-align:center;padding:4px 0;min-width:34px;font-variant-numeric:tabular-nums}
.q-table.calendar td.empty{background:var(--surface-2)}
.calendar .circled{display:inline-grid;place-items:center;width:24px;height:24px;border:2px solid var(--accent);border-radius:999px;font-weight:700;color:var(--accent-ink)}
.pictograph th{min-width:96px}

/* ---------------------------------------------------------------- results */
.result-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px;margin-bottom:30px}
.result-card{background:var(--surface);border:1px solid var(--rule);border-top:4px solid var(--rule-strong);border-radius:0 0 var(--r-m) var(--r-m);padding:18px 18px 16px;display:flex;flex-direction:column;gap:9px}
.result-card.lv-1{border-top-color:var(--lv1)}
.result-card.lv-2{border-top-color:var(--lv2)}
.result-card.lv-3{border-top-color:var(--lv3)}
.result-card.lv-4{border-top-color:var(--lv4)}
.result-comp{font-size:14px;font-weight:700;color:var(--ink-soft);letter-spacing:.01em}
.result-mark{font-family:var(--disp);font-size:32px;font-weight:800;letter-spacing:-.03em;font-variant-numeric:tabular-nums;line-height:1}
.ladder{display:flex;gap:4px}
.ladder-step{
  flex:1;height:24px;border:1px solid var(--rule);border-radius:4px;background:var(--surface-2);
  display:grid;place-items:center;font-size:11px;font-weight:700;color:var(--ink-faint);
}
.result-card.lv-1 .ladder-step.on,.result-card.lv-1 .ladder-step.past{background:var(--lv1);border-color:var(--lv1);color:var(--surface)}
.result-card.lv-2 .ladder-step.on,.result-card.lv-2 .ladder-step.past{background:var(--lv2);border-color:var(--lv2);color:var(--surface)}
.result-card.lv-3 .ladder-step.on,.result-card.lv-3 .ladder-step.past{background:var(--lv3);border-color:var(--lv3);color:var(--surface)}
.result-card.lv-4 .ladder-step.on,.result-card.lv-4 .ladder-step.past{background:var(--lv4);border-color:var(--lv4);color:var(--surface)}
.result-level{font-family:var(--disp);font-size:17px;font-weight:700}
.result-note{font-size:12.5px;color:var(--ink-faint);line-height:1.5}
.strand-box{margin-bottom:30px}
.strand-list{display:flex;flex-direction:column;gap:7px;margin-top:16px}
.strand-row{display:grid;grid-template-columns:minmax(110px,1.2fr) 3fr auto;gap:12px;align-items:center}
.strand-name{font-size:13.5px;font-weight:600}
.strand-track{height:9px;background:var(--surface-3);border-radius:999px;overflow:hidden}
.strand-fill{height:100%;border-radius:999px;background:var(--accent)}
.strand-fill.good{background:var(--good)}
.strand-fill.mid{background:var(--lv2)}
.strand-fill.low{background:var(--bad)}
.strand-val{font-size:12.5px;font-weight:600;color:var(--ink-soft);font-variant-numeric:tabular-nums;min-width:48px;text-align:right}

/* ------------------------------------------------------------------ pager */
.pager{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-top:26px;padding-top:20px;border-top:1px solid var(--rule);flex-wrap:wrap}

/* ------------------------------------------------------------ responsive */
@media (max-width:640px){
  #app{padding-block:22px 52px}
  .passage{padding:18px 16px 16px}
  .qcard{padding:15px 15px 14px}
  .para p{font-size:16px}
  .qstem{font-size:16px}
  .scorebar-inner{padding:9px 16px 7px}
  .progress-label{padding:4px 16px 6px}
  .sb-chip{min-width:56px;padding:3px 7px}
  .rail-results{margin-left:0;width:100%}
  .strand-row{grid-template-columns:1fr auto;grid-template-areas:"name val" "track track";row-gap:4px}
  .strand-name{grid-area:name}.strand-val{grid-area:val}.strand-track{grid-area:track}
  .pager{flex-direction:column;align-items:stretch}
  .pager .btn{width:100%}
}
@media (prefers-reduced-motion:reduce){
  *{animation-duration:.01ms !important;transition-duration:.01ms !important}
}
